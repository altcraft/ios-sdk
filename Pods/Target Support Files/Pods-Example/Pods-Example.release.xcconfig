CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/AGConnectCore" "${PODS_ROOT}/AGConnectCredential" "${PODS_ROOT}/HMFoundation" "${PODS_ROOT}/HiAnalytics" "${PODS_ROOT}/HmsPushSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/AGConnectCore" "${PODS_XCFRAMEWORKS_BUILD_DIR}/AGConnectCredential" "${PODS_XCFRAMEWORKS_BUILD_DIR}/HMFoundation" "${PODS_XCFRAMEWORKS_BUILD_DIR}/HiAnalytics"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
LD_RUNPATH_SEARCH_PATHS = $(inherited) '@executable_path/Frameworks' '@loader_path/Frameworks'
OTHER_LDFLAGS = $(inherited) -ObjC -framework "AGConnectCore" -framework "AGConnectCredential" -framework "HMFoundation" -framework "HiAnalytics" -framework "HmsPushSdk" -framework "Security"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/AGConnectCore" "-F${PODS_CONFIGURATION_BUILD_DIR}/AGConnectCredential" "-F${PODS_CONFIGURATION_BUILD_DIR}/HMFoundation" "-F${PODS_CONFIGURATION_BUILD_DIR}/HiAnalytics" "-F${PODS_CONFIGURATION_BUILD_DIR}/HmsPushSDK"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
